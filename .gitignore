# Local-only reference material: datasheets, photos, captures, mechanical
# scans. Keep large or non-redistributable files out of git.
/refs/

# KiCad (for when hardware/ lands)
*-backups/
*.kicad_prl
fp-info-cache
*.bak
*.bak_*
*.kicad_pcb-bak
*.sch-bak
*.lck

# JLCPCB plugin exports (gerbers, drill files, BOM/CPL, zip) and its local
# SQLite cache (project.db) -- fully regenerable from the current PCB via
# the JLCPCB plugin's "Fabrication Toolkit" export, not authoritative.
hardware/jlcpcb/

# Stale footprint-generation leftover, superseded by hardware/AramLib.pretty/
# (the library actually registered in fp-lib-table) -- kept appearing as an
# untracked directory from an earlier ESP32-C3-SuperMini.kicad_mod pass.
hardware/footprints/

# Editor local-history (nested git repo from VSCode Local History) -- never commit
.history/

# PlatformIO / build
.pio/
.vscode/
build/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS cruft
.DS_Store
Thumbs.db

# Claude Code local working state (permissions, worktrees) -- not team policy.
# Exception: kicad-mcp-logbook.md is project history, not machine-specific
# config -- tracked deliberately so it travels with the repo across machines.
.claude/*
!.claude/kicad-mcp-logbook.md
hardware/.kicad-mcp/
_*

# KiCad MCP debug/export artifacts -- regenerable, not authoritative
hardware/output/
